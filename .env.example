# Paramètres locaux facultatifs ; non chargés automatiquement. Aucun secret.
# Exporter explicitement dans le shell du processus concerné.
PIO_DATA_DIR=C:/PRIVATE-PIO/data
PIO_PORT=8787
PIO_ORIGIN=http://127.0.0.1:5173
# Proxy Vite DEV seulement (aucune URL API de production) :
PIO_DEV_API_PORT=8787
# MCP : la variable contient un CHEMIN, jamais le token.
PIO_API_URL=http://127.0.0.1:8787/api/pio
PIO_AGENT_TOKEN_FILE=C:/PRIVATE-PIO/keys/mbtg.token
# Aucun secret VITE_*, aucune clé IA/service à renseigner.
