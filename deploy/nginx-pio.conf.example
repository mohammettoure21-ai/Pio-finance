# TEMPLATE ONLY. Replace PIO_HOSTNAME and certificate paths before validation.
# This does not install nginx, obtain a certificate or configure private access.
server {
    listen 443 ssl;
    server_name PIO_HOSTNAME;
    ssl_certificate /etc/pio-finance/tls/fullchain.pem;
    ssl_certificate_key /etc/pio-finance/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/pio/current/dist;
    index index.html;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    location ^~ /api/pio/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host 127.0.0.1:8787;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ /index.html; }
}
