# MODELE INERTE NON ACTIVE. Pas de clé/certificat réels dans ce fichier.
# Bloqué par défaut: TEST-NET-1 n'est PAS une adresse de sortie Vercel approuvée.
# Ne pas enlever le contrôle d'accès sans validation distincte de l'exposition.
{
    admin off
}
2-29-156-0.sslip.io {
    @api path /api/pio/*
    handle @api {
        # A remplacer uniquement par un contrôle privé/proxy réellement vérifié.
        @approved remote_ip 192.0.2.1/32
        handle @approved {
            request_body {
                max_size 2MB
            }
            reverse_proxy 127.0.0.1:8787 {
                header_up Host 127.0.0.1:8787
                header_up -Forwarded
                header_up -X-Forwarded-Host
                header_up -X-Forwarded-Proto
            }
        }
        handle {
            respond "PIO access not activated" 403
        }
    }
    handle {
        respond "API only; use the existing Vercel frontend" 404
    }
}
